# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=school_admission
POSTGRES_PORT=5432

# Backend Connection String (For local development or container)
DATABASE_URL=Host=localhost;Port=5432;Database=school_admission;Username=postgres;Password=your_postgres_password_here

# ==========================================
# Backend Configuration
# ==========================================
HOLD_DURATION_SECONDS=600
BACKEND_PORT=8080

# ==========================================
# Frontend Configuration
# ==========================================
VITE_API_URL=http://localhost:8080
FRONTEND_PORT=3000
